{
  "name": "opticmesh-desktop",
  "version": "1.3.3-beta",
  "packageManager": "pnpm@11.18.0",
  "private": true,
  "description": "OpticMesh LED test-pattern, Resolume pixel-map, and 3D simulation workspace.",
  "license": "MIT",
  "main": "electron-main.cjs",
  "author": "OpticMesh contributors",
  "homepage": "https://github.com/johnjjdave/opticmesh",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnjjdave/opticmesh.git"
  },
  "scripts": {
    "build": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lo2s.opticmesh",
    "productName": "OpticMesh Beta",
    "artifactName": "OpticMesh-${version}-Portable.${ext}",
    "asar": true,
    "asarUnpack": [
      "native/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "icons/**/*",
      "native/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
